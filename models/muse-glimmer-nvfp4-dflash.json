{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "openai-compatible": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Muse Glimmer local vLLM (NVFP4 + DFlash)",
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1"
      },
      "models": {
        "muse-glimmer-nvfp4-dflash": {
          "name": "Muse Glimmer 30B NVFP4 + DFlash on Spark",
          "model": "muse-glimmer-30b",
          "tools": false,
          "rate_limit_rpm": 300,
          "timeout_seconds": 300,
          "extra_body": {
            "max_tokens": 256,
            "temperature": 1.0,
            "top_p": 0.95,
            "top_k": 64,
            "stream": false
          }
        }
      }
    }
  }
}
