{
  "provider": {
    "openrouter": {
      "name": "OpenRouter",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKeyEnv": "OPENROUTER_API_KEY"
      },
      "models": {
        "inkling-free": {
          "name": "Inkling (Free)",
          "model": "thinkingmachines/inkling:free",
          "rate_limit_rpm": 10,
          "timeout_seconds": 180
        }
      }
    }
  }
}
